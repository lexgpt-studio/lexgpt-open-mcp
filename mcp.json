{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "lexgpt-open": {
      "type": "streamable-http",
      "url": "https://open.lexgpt.com.br/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://open.lexgpt.com.br/mcp",
            "baseScopes": [
              "open:read"
            ],
            "defaultScopes": [
              "open:work:read",
              "open:work:write",
              "open:notify"
            ]
          }
        }
      }
    }
  }
}
